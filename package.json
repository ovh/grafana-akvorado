{
  "name": "akvorado",
  "version": "2.0.2",
  "description": "Akvorado netflow data source using akvorado api",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "licenses": "node generate-licenses.js",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "prepare": "lezer-generator --typeScript src/codemirror/lang-filter/syntax.grammar -o src/codemirror/lang-filter/parser.ts"
  },
  "author": "Ovh",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@grafana/eslint-config": "^8.2.0",
    "@grafana/plugin-e2e": "^3.11.0",
    "@grafana/sign-plugin": "^3.2.2",
    "@grafana/tsconfig": "^2.0.0",
    "@playwright/test": "^1.52.0",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.194",
    "@types/node": "^20.8.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.2.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "axios": "^1.18.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jsdoc": "^51.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-webpack-plugin": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.5.0",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "license-checker": "^25.0.1",
    "prettier": "2.8.8",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "semver": "^7.6.3",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-hook-plugin": "^1.0.7",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.17.0",
    "@codemirror/state": "^6.4.1",
    "@emotion/css": "11.10.6",
    "@grafana/data": "13.1.3",
    "@grafana/i18n": "13.1.3",
    "@grafana/plugin-ui": "^0.16.1",
    "@grafana/runtime": "13.1.3",
    "@grafana/schema": "13.1.3",
    "@grafana/ui": "13.1.3",
    "@lezer/generator": "^1.7.1",
    "@lezer/lr": "^1.0.0",
    "@uiw/react-codemirror": "^4.23.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tslib": "2.5.3"
  },
  "packageManager": "npm@10.2.4",
  "overrides": {
    "brace-expansion@2": "^2.1.4",
    "js-yaml": "^4.3.1",
    "minimatch@9": "^9.0.9",
    "nanoid": "^3.3.18",
    "picomatch@2": "^2.3.2",
    "postcss": "^8.5.26",
    "react-use": "17.6.1",
    "serialize-javascript": "^7.1.0",
    "websocket-driver": "^0.7.5",
    "ws": "^8.21.3"
  }
